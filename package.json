{
  "name": "skipsponsor-ai",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Claude-powered YouTube sponsor skip Chrome extension + detection API",
  "author": "Juan Jaramillo",
  "homepage": "https://github.com/juanjaragavi/skip-sponsor-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanjaragavi/skip-sponsor-ai.git"
  },
  "bugs": {
    "url": "https://github.com/juanjaragavi/skip-sponsor-ai/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "port": "3040"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,json,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/tests/integration",
    "test:e2e": "playwright test",
    "build:extension": "vite build",
    "build:api": "node scripts/build-api.mjs",
    "dev:extension": "vite --mode development",
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/server.ts",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "local": "bash scripts/local.sh",
    "start:api": "node --enable-source-maps dist/api/server.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env src/api/db/migrate-cli.ts",
    "db:dump:local": "bash scripts/db-local.sh dump",
    "db:restore:local": "bash scripts/db-local.sh restore",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "legal:build": "tsx scripts/build-legal.ts",
    "legal:check": "tsx scripts/build-legal.ts --check",
    "package:extension": "npm run build:extension && node scripts/zip-extension.mjs",
    "icons": "node scripts/build-icons.mjs",
    "stage:api": "node scripts/stage-api-context.mjs",
    "package:store": "VITE_API_BASE_URL=https://api-skipsponsor-main.cloud.devspeak.dev npm run package:extension"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.5",
    "ioredis": "^5.3.2",
    "opossum": "^8.1.3",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.2",
    "@fontsource-variable/roboto": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.0.332",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.4.0",
    "lucide": "^1.55.0",
    "prettier": "^3.9.10",
    "tsx": "^4.11.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
