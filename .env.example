# SkipSponsor AI - Environment Variables Example
# Copy this file to .env and .env.local, then fill in your values
# NEVER commit actual .env files to git

# ============================================================================
# EXTENSION CLIENT VARIABLES (.env.local)
# Loaded at build time via Vite
# ============================================================================

# Backend API endpoint (used by extension to fetch segments)
# For local development: http://localhost:3000
# For production: https://api.skipsponsor.ai
VITE_API_BASE_URL=http://localhost:3000

# Environment mode: development | staging | production
VITE_ENVIRONMENT=development

# Enable verbose console logging in extension (content script + service worker)
# Set to true for development, false for production
VITE_DEBUG_MODE=true

# ============================================================================
# BACKEND SERVER VARIABLES (.env)
# Loaded at server startup
# ============================================================================

# Anthropic API Configuration
# Get your key from: https://console.anthropic.com/account/keys
# Format: sk-ant-[base64 string]
# REQUIRED for LLM classification
ANTHROPIC_API_KEY=sk-ant-abc123xyz789...

# Database Configuration
# PostgreSQL connection string
# Local dev: postgresql://skipsponsor:password@localhost:5432/skipsponsor
# Production: (managed RDS endpoint)
DATABASE_URL=postgresql://skipsponsor:password@localhost:5432/skipsponsor

# Redis Configuration
# Cache backend for segment TTL (30-day expiry)
# Local dev: redis://localhost:6379
# Production: (ElastiCache endpoint)
REDIS_URL=redis://localhost:6379

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Node environment mode: development | staging | production
# Controls logging verbosity, error handling, response headers
NODE_ENV=development

# Logging level: trace | debug | info | warn | error | fatal
# trace: most verbose, fatal: least verbose
LOG_LEVEL=debug

# Server listen port (HTTP)
PORT=3000

# CORS allowed origin(s)
# Use * for development, specific domain for production (e.g., https://example.com)
CORS_ORIGIN=*

# ============================================================================
# LLM CLASSIFICATION CONFIGURATION
# ============================================================================

# Claude model selection strategy
# Primary: claude-3-5-haiku-latest (fast, cheap)
# Fallback: claude-3-5-sonnet-latest (slower, more accurate)
# These are inferred in code; edit src/api/services/llm-client.ts to change

# LLM inference timeout in milliseconds
# If Claude takes longer than this, request is retried or escalated
# Default: 8000ms (8 seconds)
LLM_TIMEOUT_MS=8000

# Number of retry attempts on LLM timeout
# 0 = no retry, go straight to fallback/error
# Default: 1 (Haiku fails → retry Haiku → escalate to Sonnet)
LLM_MAX_RETRIES=1

# Default confidence threshold for accepting sponsor segments
# Range: 0.5 (very lenient) to 0.95 (very strict)
# Default: 0.78 (balance between precision and recall)
# Segments with confidence < threshold are discarded
CONFIDENCE_THRESHOLD=0.78

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

# Video analysis cache retention period (days)
# After this period, analysis is hard-deleted from Redis and PostgreSQL
# Default: 30 days (per spec §1.5)
CACHE_TTL_DAYS=30

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Rate limit window duration in milliseconds
# Requests are counted within this rolling window
# Default: 60000ms (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests allowed per install within the window
# Default: 60 (60 requests per minute per install)
RATE_LIMIT_MAX_REQUESTS=60

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Sentry error tracking DSN (optional)
# Leave empty to disable error reporting
# Get DSN from: https://sentry.io/settings/[org]/projects/
SENTRY_DSN=

# OpenTelemetry tracing endpoint (optional)
# For integration with observability platforms
# Leave empty to disable distributed tracing
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================================
# SECURITY & SECRETS
# ============================================================================

# Install token secret (used for signing/verifying install tokens)
# Should be a 32-character random string generated on first startup
# Example: head -c 32 /dev/urandom | base64
INSTALL_TOKEN_SECRET=your-random-secret-here

# ============================================================================
# OPTIONAL: LOCAL DEVELOPMENT DATABASE CREDENTIALS
# (If using docker-compose.yml)
# ============================================================================

POSTGRES_USER=skipsponsor
POSTGRES_PASSWORD=password
POSTGRES_DB=skipsponsor
POSTGRES_INITDB_ARGS=-c max_connections=100

# ============================================================================
# NOTES
# ============================================================================

# 1. SENSITIVE DATA: Never commit .env files to git
#    Add to .gitignore: .env, .env.local, .env.*.local
#
# 2. API KEY SECURITY:
#    - Use AWS Secrets Manager, Azure Key Vault, or HashiCorp Vault in production
#    - Rotate keys quarterly
#    - Use separate keys for dev/staging/prod
#    - Monitor key usage in Anthropic console
#
# 3. DATABASE CREDENTIALS:
#    - Use strong passwords (min 32 characters)
#    - Enable SSL/TLS for remote connections
#    - Use IAM authentication for AWS RDS
#
# 4. LOCAL DEVELOPMENT:
#    - Copy this file to .env.local and .env
#    - Fill in local values (API key, database creds)
#    - Never commit these filled files
#
# 5. PRODUCTION DEPLOYMENT:
#    - Use environment variable injection at container runtime
#    - Use secrets management service (AWS Secrets Manager, etc.)
#    - Enable audit logging for all secret access
#    - Implement automatic secret rotation
#
# 6. DOCKER-COMPOSE DEVELOPMENT:
#    - PostgreSQL and Redis started with docker-compose up -d
#    - Default credentials in docker-compose.yml
#    - Change passwords before production use
