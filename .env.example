# SkipSponsor AI - Environment Variables Example
# Copy this file to .env and .env.local, then fill in your values
# NEVER commit actual .env files to git

# ============================================================================
# EXTENSION CLIENT VARIABLES (.env.local)
# Loaded at build time via Vite
# ============================================================================

# Backend API endpoint (used by extension to fetch segments), fixed at build time.
# Dev (`npm run dev:extension`, `vite build --mode development`): defaults to
# http://localhost:3040 when unset.
# Production builds (`npm run build:extension`, `npm run package:extension`)
# FAIL without it and require https: put VITE_API_BASE_URL=https://api.<your-domain>
# in .env.production (gitignored).
VITE_API_BASE_URL=http://localhost:3040

# Environment mode: development | staging | production  (not read by code yet)
VITE_ENVIRONMENT=development

# Enable verbose console logging in extension (content script + service worker)
# Set to true for development, false for production  (not read by code yet)
VITE_DEBUG_MODE=true

# ============================================================================
# BACKEND SERVER VARIABLES (.env)
# Loaded at server startup
# ============================================================================

# Anthropic API Configuration
# Get your key from: https://console.anthropic.com/account/keys
# Format: sk-ant-[base64 string]
# REQUIRED for LLM classification
ANTHROPIC_API_KEY=sk-ant-abc123xyz789...

# Database Configuration
# PostgreSQL connection string. Setting it switches persistence to Postgres;
# unset = in-memory store (dev/tests only; production refuses to start without
# it unless PERSISTENCE=memory). Apply the schema with `npm run db:migrate`.
# Local dev: postgresql://skipsponsor:password@localhost:5434/skipsponsor
# Production: see docs/DEPLOY.md
DATABASE_URL=postgresql://skipsponsor:password@localhost:5434/skipsponsor

# Redis Configuration (optional)
# Hot cache in front of Postgres; Postgres stays the source of truth.
# Leave empty to run without Redis. Local dev: redis://localhost:6380
REDIS_URL=

# Persistence override: memory | postgres (default: postgres when DATABASE_URL is set)
PERSISTENCE=
# Postgres pool size per API instance
PG_POOL_MAX=5
# 1 = container start.sh runs migrations before the server (default 0)
DB_MIGRATE_ON_START=0

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Node environment mode: development | staging | production
# Controls logging verbosity, error handling, response headers
NODE_ENV=development

# Logging level: trace | debug | info | warn | error | fatal  (not read by code yet)
# trace: most verbose, fatal: least verbose
LOG_LEVEL=debug

# Server listen port (HTTP). Local default 3040 (unique across DevSpeak projects);
# the container image listens on 3000 when PORT is unset.
PORT=3040

# CORS allowed origin(s), comma-separated. Production: the store item's origin,
# chrome-extension://<item id>. * reflects any origin. Unset: any origin in
# development, any chrome-extension:// origin in production.
CORS_ORIGIN=*

# 1 = trust X-Forwarded-For (behind InstaCloud's router, Caddy, a load balancer)
TRUST_PROXY=0

# 1 = advertise globalKill in GET /v1/config (clients do not act on it yet)
GLOBAL_KILL=0
# Public origin of this API (default http://localhost:<PORT>). Leave commented
# out unless needed: an empty value is used as-is.
# API_BASE=
# Directory of the SQL migrations `npm run db:migrate` applies
# (default <cwd>/infra/db/migrations). Leave commented out unless needed.
# MIGRATIONS_DIR=
# Deployed commit echoed by GET /healthz as `commit`; the first set of
# GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_SHA, SOURCE_COMMIT wins, else "unknown".
# Set by the build or the platform, never by hand.
# GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_SHA=
# SOURCE_COMMIT=

# ============================================================================
# LLM CLASSIFICATION CONFIGURATION
# ============================================================================

# Claude model selection strategy
# Primary: claude-haiku-4-5-20251001 (fast, cheap)
# Fallback: claude-sonnet-5-5 (slower, more accurate)
# Models come from MODEL_POLICY in src/shared/constants.ts (not env)

# LLM inference timeout in milliseconds
# If Claude takes longer than this, request is retried or escalated
# Default: 8000ms (8 seconds)  (not read by code yet: MODEL_POLICY.timeoutMs)
LLM_TIMEOUT_MS=8000

# Number of retry attempts on LLM timeout
# 0 = no retry, go straight to fallback/error
# Default: 1 (Haiku fails → retry Haiku → escalate to Sonnet)  (not read by code yet)
LLM_MAX_RETRIES=1

# Default confidence threshold for accepting sponsor segments
# Range: 0.5 (very lenient) to 0.95 (very strict)
# Default: 0.78 (balance between precision and recall)
# Segments with confidence < threshold are discarded  (not read by code yet)
CONFIDENCE_THRESHOLD=0.78

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

# Video analysis cache retention period (days)
# After this period, analysis is hard-deleted from Redis and PostgreSQL
# (hourly purge). Must match PRIVACY.md. Default: 30 days (per spec §1.5)
CACHE_TTL_DAYS=30

# ============================================================================
# COST GUARD
# ============================================================================

# Fresh (uncached) LLM analyses one install may trigger per UTC day.
# Cached videos never count. Over the limit the extension keeps cached and
# SponsorBlock results and shows a notice.
DAILY_ANALYSES_PER_INSTALL=25

# Global LLM spend cap per UTC day, in USD (estimated from token usage x list
# price). When reached, new LLM analyses stop for everyone until 00:00 UTC.
# 0 = LLM switched off (emergency stop).
LLM_DAILY_BUDGET_USD=2

# New install tokens one IP may mint per hour (POST /v1/installs)
INSTALLS_PER_IP_PER_HOUR=20

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Rate limit window duration in milliseconds
# Requests are counted within this rolling window
# Default: 60000ms (1 minute)  (not read by code yet: fixed 500 req/min per IP)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests allowed per install within the window
# Default: 60 (60 requests per minute per install)  (not read by code yet)
RATE_LIMIT_MAX_REQUESTS=60

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Sentry error tracking DSN (optional)
# Leave empty to disable error reporting  (not read by code yet)
# Get DSN from: https://sentry.io/settings/[org]/projects/
SENTRY_DSN=

# OpenTelemetry tracing endpoint (optional)
# For integration with observability platforms
# Leave empty to disable distributed tracing  (not read by code yet)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================================
# SECURITY & SECRETS
# ============================================================================

# Install token secret: HMAC key for the anonymous install tokens issued by
# POST /v1/installs (per-install daily quota). Required in production, at
# least 32 characters: openssl rand -base64 48
# Leave empty in local development: any opaque bearer token is then accepted.
INSTALL_TOKEN_SECRET=

# ============================================================================
# OPTIONAL: LOCAL DEVELOPMENT DATABASE CREDENTIALS
# (If using docker-compose.yml)
# ============================================================================

POSTGRES_USER=skipsponsor
POSTGRES_PASSWORD=password
POSTGRES_DB=skipsponsor
POSTGRES_INITDB_ARGS=-c max_connections=100

# ============================================================================
# NOTES
# ============================================================================

# 1. SENSITIVE DATA: Never commit .env files to git
#    Add to .gitignore: .env, .env.local, .env.*.local
#
# 2. API KEY SECURITY:
#    - Use AWS Secrets Manager, Azure Key Vault, or HashiCorp Vault in production
#    - Rotate keys quarterly
#    - Use separate keys for dev/staging/prod
#    - Monitor key usage in Anthropic console
#
# 3. DATABASE CREDENTIALS:
#    - Use strong passwords (min 32 characters)
#    - Enable SSL/TLS for remote connections
#    - Use IAM authentication for AWS RDS
#
# 4. LOCAL DEVELOPMENT:
#    - Copy this file to .env.local and .env
#    - Fill in local values (API key, database creds)
#    - Never commit these filled files
#
# 5. PRODUCTION DEPLOYMENT:
#    - Use environment variable injection at container runtime
#    - Use secrets management service (AWS Secrets Manager, etc.)
#    - Enable audit logging for all secret access
#    - Implement automatic secret rotation
#
# 6. DOCKER-COMPOSE DEVELOPMENT:
#    - PostgreSQL and Redis started with docker-compose up -d
#    - Default credentials in docker-compose.yml
#    - Change passwords before production use
